{
  "id": "agent-knock-knock",
  "name": "Agent Knock Knock",
  "description": "Control local Codex and Claude Code through shared tmux terminals, with native-thread lifecycle controls, live monitoring, approvals, and human takeover.",
  "icon": "https://raw.githubusercontent.com/scotthuang/agent-knock-knock/main/docs/assets/agent-knock-knock-icon.png",
  "activation": {
    "onStartup": true,
    "onCommands": ["akk"]
  },
  "commandAliases": [
    {
      "name": "akk",
      "kind": "runtime-slash"
    }
  ],
  "contracts": {
    "tools": [
      "agent_knock_knock_list",
      "agent_knock_knock_list_resumable_threads",
      "agent_knock_knock_new_thread",
      "agent_knock_knock_reconcile_binding",
      "agent_knock_knock_resume_thread",
      "agent_knock_knock_status",
      "agent_knock_knock_send",
      "agent_knock_knock_respond",
      "agent_knock_knock_renew",
      "agent_knock_knock_retry_callback",
      "agent_knock_knock_cancel",
      "agent_knock_knock_close",
      "agent_knock_knock_approve"
    ]
  },
  "toolMetadata": {
    "agent_knock_knock_list": {
      "optional": true
    },
    "agent_knock_knock_list_resumable_threads": {
      "optional": true
    },
    "agent_knock_knock_new_thread": {
      "optional": true
    },
    "agent_knock_knock_reconcile_binding": {
      "optional": true
    },
    "agent_knock_knock_resume_thread": {
      "optional": true
    },
    "agent_knock_knock_status": {
      "optional": true
    },
    "agent_knock_knock_send": {
      "optional": true
    },
    "agent_knock_knock_respond": {
      "optional": true
    },
    "agent_knock_knock_renew": {
      "optional": true
    },
    "agent_knock_knock_retry_callback": {
      "optional": true
    },
    "agent_knock_knock_cancel": {
      "optional": true
    },
    "agent_knock_knock_close": {
      "optional": true
    },
    "agent_knock_knock_approve": {
      "optional": true
    }
  },
  "skills": [
    "templates/openclaw-skills/agent-knock-knock"
  ],
  "configSchema": {
    "type": "object",
    "additionalProperties": false,
    "properties": {
      "storeDir": {
        "type": "string",
        "description": "Stable AKK Store root. Defaults to ~/.agent-knock-knock/store and contains the compatibility manifest, authoritative managed Sessions, and Turn records."
      },
      "openclawBin": {
        "type": "string",
        "description": "Path to the OpenClaw CLI used by callback delivery. Defaults to PATH plus common user install locations."
      },
      "codexHome": {
        "type": "string",
        "description": "Optional CODEX_HOME path used to correlate Codex session metadata with eligible tmux terminals."
      },
      "idleTimeoutMinutes": {
        "type": "number",
        "description": "Minutes a completed or idle AKK turn record remains retained before controlled reconciliation closes that turn. The continuing AKK session identity is preserved. Defaults to 10080."
      },
      "agentTimeoutMinutes": {
        "type": "number",
        "description": "Minutes without terminal activity or a coding-agent callback before AKK marks a managed turn stalled. Defaults to 60."
      },
      "agentHardTimeoutMinutes": {
        "type": "number",
        "exclusiveMinimum": 0,
        "description": "Fallback lifetime ceiling for a terminal bridge monitor that has not produced approval or completion. Defaults to 720 minutes."
      },
      "autoApprove": {
        "type": "object",
        "additionalProperties": false,
        "description": "Deterministic, default-disabled exact command-vector and workspace policy for terminal-controlled Codex and hookless Claude. Claude auto-approval also requires a current managed one-time Bash prompt with matching local transcript evidence. Policy configuration is trusted and never exposed as model-controlled tool parameters.",
        "properties": {
          "enabled": {
            "type": "boolean",
            "default": false
          },
          "rules": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["id", "agents", "workspaces", "commands"],
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "agents": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "string",
                    "enum": ["codex", "claude"]
                  }
                },
                "workspaces": {
                  "type": "array",
                  "minItems": 1,
                  "description": "One or more absolute workspace roots authorized by this automatic-approval rule.",
                  "items": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "commands": {
                  "type": "array",
                  "minItems": 1,
                  "items": {
                    "type": "array",
                    "minItems": 1,
                    "items": {
                      "type": "string"
                    }
                  }
                }
              }
            }
          }
        }
      }
    }
  }
}
